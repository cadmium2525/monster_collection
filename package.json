{
  "name": "monster-construction-sim8-7",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "モンスターコンストラクション Sim8.7 playable static web game",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build-pages.mjs",
    "preview": "node scripts/serve.mjs --root dist",
    "test": "node --test",
    "test:engine": "node --test tests/battle tests/deck",
    "sim": "node tools/ai-lab.mjs",
    "sim:decks": "node tools/deck-lab.mjs",
    "sim:tournament": "node tools/tournament-lab.mjs",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}
