rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validDeck() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'deckId', 'deckName', 'cards', 'totalPlayTp', 'qualification',
          'highestReached', 'updatedAt', 'ownerUserId'
        ])
        && d.deckId is string
        && d.deckName is string
        && d.deckName.size() > 0
        && d.deckName.size() <= 90
        && d.cards is list
        && d.cards.size() == 40
        && d.totalPlayTp is number
        && d.ownerUserId == request.auth.uid
        && d.qualification in ['bronze', 'silver', 'gold', 'legend']
        && d.highestReached in ['bronze', 'silver', 'gold', 'legend'];
    }

    function validChampion() {
      let c = request.resource.data;
      return c.keys().hasAll([
          'championUserId', 'championDisplayName', 'championDeckId',
          'championDeckName', 'championDeckSnapshot', 'crownedAt',
          'defenseCount', 'championVersion'
        ])
        && c.championUserId is string
        && c.championDisplayName is string
        && c.championDeckId is string
        && c.championDeckName is string
        && c.championDeckSnapshot is list
        && c.championDeckSnapshot.size() == 40
        && (!('championGrowthSnapshot' in c)
          || (c.championGrowthSnapshot is map && c.championGrowthSnapshot.size() <= 40))
        && (!('championSnapshotVersion' in c) || c.championSnapshotVersion is int)
        && c.defenseCount is int
        && c.defenseCount >= 0
        && c.championVersion is int;
    }

    function validLegendDeck(publicDeckId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'publicDeckId', 'ownerUserId', 'ownerDisplayName', 'sourceDeckId',
          'deckName', 'cards', 'totalPlayTp', 'qualification', 'highestReached',
          'representativeMonsterId', 'schemaVersion', 'publishedAt', 'updatedAt'
        ])
        && d.publicDeckId == publicDeckId
        && d.ownerUserId == request.auth.uid
        && d.ownerDisplayName is string
        && d.ownerDisplayName.size() > 0
        && d.ownerDisplayName.size() <= 24
        && d.sourceDeckId is string
        && d.deckName is string
        && d.deckName.size() > 0
        && d.deckName.size() <= 30
        && d.cards is list
        && d.cards.size() == 40
        && d.totalPlayTp is number
        && d.qualification == 'legend'
        && d.highestReached in ['bronze', 'silver', 'gold', 'legend']
        && (d.representativeMonsterId == null || d.representativeMonsterId is string)
        && d.schemaVersion == 1
        && d.publishedAt is timestamp
        && d.updatedAt is timestamp;
    }

    function validLegendSource(d) {
      let ownerId = request.auth.uid;
      let sourceDeckId = d.sourceDeckId;
      let source = get(/databases/$(database)/documents/users/$(ownerId)/savedDecks/$(sourceDeckId)).data;
      let profile = get(/databases/$(database)/documents/users/$(ownerId)).data;
      return source.ownerUserId == ownerId
        && source.deckId == sourceDeckId
        && profile.economy is map
        && profile.economy.tournamentQualification == 'legend'
        && source.deckName == d.deckName
        && source.cards == d.cards
        && source.totalPlayTp == d.totalPlayTp
        && source.highestReached == d.highestReached
        && source.representativeMonsterId == d.representativeMonsterId
        && profile.displayName == d.ownerDisplayName;
    }

    function validArenaDeck(publicDeckId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'publicDeckId', 'ownerUserId', 'ownerDisplayName', 'sourceDeckId',
          'deckName', 'cards', 'totalPlayTp', 'representativeMonsterId',
          'arenaRating', 'arenaRank', 'schemaVersion', 'registeredAt', 'updatedAt'
        ])
        && d.publicDeckId == publicDeckId
        && d.ownerUserId == request.auth.uid
        && d.ownerDisplayName is string
        && d.ownerDisplayName.size() > 0
        && d.ownerDisplayName.size() <= 24
        && d.sourceDeckId is string
        && d.deckName is string
        && d.deckName.size() > 0
        && d.deckName.size() <= 30
        && d.cards is list
        && d.cards.size() == 40
        && d.totalPlayTp is number
        && (d.representativeMonsterId == null || d.representativeMonsterId is string)
        && d.arenaRating is int
        && d.arenaRating >= 900
        && d.arenaRank in ['D', 'C', 'B', 'A', 'S', 'MASTER']
        && d.schemaVersion == 1
        && d.registeredAt is timestamp
        && d.updatedAt is timestamp;
    }

    function validArenaSource(d) {
      let ownerId = request.auth.uid;
      let source = get(/databases/$(database)/documents/users/$(ownerId)/savedDecks/$(d.sourceDeckId)).data;
      let profile = get(/databases/$(database)/documents/users/$(ownerId)).data;
      return source.ownerUserId == ownerId
        && source.deckId == d.sourceDeckId
        && source.deckName == d.deckName
        && source.cards == d.cards
        && source.totalPlayTp == d.totalPlayTp
        && source.representativeMonsterId == d.representativeMonsterId
        && profile.displayName == d.ownerDisplayName;
    }

    function validLegendArchive(archiveId) {
      let d = request.resource.data;
      let champion = getAfter(/databases/$(database)/documents/gameState/champion).data;
      return d.keys().hasOnly([
          'archiveId', 'championUserId', 'championDisplayName', 'championDeckId',
          'championDeckName', 'championDeckSnapshot', 'championGrowthSnapshot',
          'championSnapshotVersion', 'representativeMonsterId', 'crownedAt',
          'defenseCount', 'championVersion', 'schemaVersion', 'archivedAt'
        ])
        && d.archiveId == archiveId
        && d.championUserId == request.auth.uid
        && d.championUserId == champion.championUserId
        && d.championVersion == champion.championVersion
        && d.championDeckSnapshot == champion.championDeckSnapshot
        && d.championGrowthSnapshot == champion.championGrowthSnapshot
        && d.championVersion is int
        && d.schemaVersion == 1
        && d.archivedAt == request.time;
    }

    match /users/{userId} {
      allow read, create, update: if owns(userId);
      allow delete: if false;

      match /savedDecks/{deckId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId) && validDeck() && request.resource.data.deckId == deckId;
        allow delete: if owns(userId);
      }
    }

    match /gameState/champion {
      allow read: if true;
      allow create: if signedIn()
        && validChampion()
        && request.resource.data.championUserId == request.auth.uid
        && request.resource.data.crownedAt == request.time
        && request.resource.data.championGrowthSnapshot is map
        && request.resource.data.championSnapshotVersion == 2
        && request.resource.data.championVersion == 1;
      allow update: if signedIn()
        && validChampion()
        && request.resource.data.championVersion == resource.data.championVersion + 1
        && (
          (
            request.resource.data.championUserId == request.auth.uid
            && request.resource.data.crownedAt == request.time
            && request.resource.data.championGrowthSnapshot is map
            && request.resource.data.championSnapshotVersion == 2
            && request.resource.data.defenseCount == 0
          )
          ||
          (
            resource.data.championUserId == request.auth.uid
            && request.resource.data.championUserId == resource.data.championUserId
            && request.resource.data.crownedAt == resource.data.crownedAt
            && request.resource.data.defenseCount == resource.data.defenseCount + 1
          )
        );
      allow delete: if false;
    }

    match /legendDecks/{publicDeckId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validLegendDeck(publicDeckId)
        && validLegendSource(request.resource.data)
        && request.resource.data.publishedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && validLegendDeck(publicDeckId)
        && validLegendSource(request.resource.data)
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.sourceDeckId == resource.data.sourceDeckId
        && request.resource.data.publishedAt == resource.data.publishedAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    match /arenaDecks/{publicDeckId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validArenaDeck(publicDeckId)
        && validArenaSource(request.resource.data)
        && request.resource.data.registeredAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && validArenaDeck(publicDeckId)
        && validArenaSource(request.resource.data)
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.sourceDeckId == resource.data.sourceDeckId
        && request.resource.data.registeredAt == resource.data.registeredAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    match /legendArchives/{archiveId} {
      allow read: if signedIn();
      allow create: if signedIn() && validLegendArchive(archiveId);
      allow update, delete: if false;
    }
  }
}
